// Small controls built from Slint primitives for the software renderer.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    preferred-width: 132px; preferred-height: 32px;
    background: !enabled ? #f4f5f7 : area.pressed ? #dce6fa : area.has-hover ? #edf2fb : #ffffff;
    border-width: 1px; border-color: scope.has-focus ? #5789d4 : #cad2df; border-radius: 4px;
    forward-focus: scope;
    accessible-role: button; accessible-label: text; accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Text { text: root.text; color: root.enabled ? #27364b : #aab1bf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    area := TouchArea { enabled: root.enabled; clicked => { scope.focus(); root.clicked(); } }
    scope := FocusScope { x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; }
    }
}
export component LineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    callback edited;
    preferred-height: 32px;
    background: enabled ? #ffffff : #f3f5f8;
    border-width: 1px; border-color: input.has-focus ? #5789d4 : #cad2df; border-radius: 4px;
    forward-focus: input;
    if root.text == "" && !input.has-focus: Text { x: 9px; width: parent.width - 18px; height: parent.height; text: root.placeholder-text; color: #98a2b3; font-size: 12px; vertical-alignment: center; overflow: elide; }
    input := TextInput { x: 9px; y: 7px; width: parent.width - 18px; height: parent.height - 14px; text <=> root.text; read-only: !root.enabled; single-line: true; font-size: 12px; color: #27364b; edited => { root.edited(); } }
}
export component ComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(string);
    preferred-width: 160px; preferred-height: 32px;
    background: #ffffff; border-width: 1px; border-color: #cad2df; border-radius: 4px;
    forward-focus: scope;
    Text { x: 10px; width: parent.width - 36px; height: parent.height; text: root.model[root.current-index]; color: #27364b; font-size: 12px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 24px; width: 20px; height: parent.height; text: "▾"; color: #667085; vertical-alignment: center; }
    TouchArea { enabled: root.enabled; clicked => { scope.focus(); popup.show(); } }
    scope := FocusScope { x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { popup.show(); return accept; } return reject; }
    }
    popup := PopupWindow { x: 0px; y: root.height; width: root.width; height: root.model.length * 32px;
        VerticalLayout { spacing: 0px;
            for value[index] in root.model: Rectangle { height: 32px; background: option.has-hover ? #e4edff : #ffffff;
                Text { x: 10px; width: parent.width - 20px; height: parent.height; text: value; color: #27364b; font-size: 12px; vertical-alignment: center; }
                option := TouchArea { clicked => { root.current-index = index; root.selected(value); popup.close(); } }
            }
        }
    }
}
